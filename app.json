{
  "expo": {
    "name": "Nourish",
    "slug": "nourish-app",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nourish-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e3a2f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.replit.nourish",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ristudio.nourish",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1e3a2f"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "react-native-health",
        {
          "healthSharePermission": "Nourish uses your Apple Health sleep data to automatically fill in your nightly sleep hours in the Inflammation Tracker.",
          "healthUpdatePermission": "Nourish does not write data to Apple Health."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "8f259da7-0d7c-480b-8f48-7c862d2bb34f"
      }
    },
    "owner": "jojo16467"
  }
}
