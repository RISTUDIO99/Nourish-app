# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
static-build/

# Native (generated by EAS — do not commit)
ios/
android/

# Signing / certificates — never commit these
google-service-account.json
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro
.metro-health-check*
.metro-cache/

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# Local env files — never commit secrets
.env
.env*.local

# TypeScript build cache
*.tsbuildinfo

# Replit-specific — not needed outside Replit
.replit-artifact/
.replit
replit.nix
